# --- Site ---
# Public URL of the site (used for sitemap, RSS, auth redirects).
EMDASH_SITE_URL=https://livingandglow.com

# Encryption key for stored plugin secrets.
# Generate one with: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# --- Postgres (docker-compose db service) ---
POSTGRES_DB=livingandglow
POSTGRES_USER=livingandglow
POSTGRES_PASSWORD=

# The app builds DATABASE_URL from the POSTGRES_* vars in compose.
# For non-Docker setups, set it directly:
# DATABASE_URL=postgres://livingandglow:password@localhost:5432/livingandglow

# --- Bunny.net Storage (S3-compatible) ---
# When S3_ENDPOINT is set, media uploads go to Bunny instead of ./uploads.
# Bunny dashboard -> Storage -> your zone -> FTP & API Access shows these.
#
# S3_ENDPOINT: the S3-compatible regional host (note the "-s3" infix), e.g.
#   https://de-s3.storage.bunnycdn.com  (Falkenstein)
#   https://ny-s3.storage.bunnycdn.com  (New York)
#   https://sg-s3.storage.bunnycdn.com  (Singapore)
#   https://uk-s3.storage.bunnycdn.com  (London)
S3_ENDPOINT=
# Bucket = the storage zone name.
S3_BUCKET=
# Access key ID = the storage zone name. Secret = the zone's password/access key.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Region for request signing — match the zone's region (e.g. de, ny, sg, uk).
S3_REGION=
# Public URL prefix for generated media URLs. Best: a Bunny pull zone in front
# of the storage zone, e.g. https://livingandglow.b-cdn.net
# Without a pull zone, use https://<region>.storage.bunnycdn.com/<zone-name>
S3_PUBLIC_URL=
