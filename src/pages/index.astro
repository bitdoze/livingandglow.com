---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const CATEGORY_SECTIONS = [
	{
		slug: "fashion-style",
		label: "Fashion & Style",
		blurb:
			"Wearable outfit formulas, wardrobe basics that pull their weight, and the accessories that finish a look.",
	},
	{
		slug: "beauty-getting-ready",
		label: "Beauty & Getting Ready",
		blurb:
			"Makeup, hair accessories and getting-ready setups that keep mornings simple and organized.",
	},
	{
		slug: "home-living",
		label: "Home & Living",
		blurb:
			"Cozy rooms and practical organization — lighting, textiles and storage that earn their place.",
	},
];

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 12,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);

// Start-here: the newest guide in each launch category.
const startHere = CATEGORY_SECTIONS.map((section) => ({
	...section,
	post:
		posts.find((p) =>
			(categoriesByEntry.get(p.data.id) ?? []).some(
				(t) => t.slug === section.slug,
			),
		) ?? null,
}));

const startHereIds = new Set(
	startHere.map((s) => s.post?.data.id).filter(Boolean),
);
const recentPosts = posts
	.filter((p) => !startHereIds.has(p.data.id))
	.slice(0, 6)
	.map((post) => ({
		post,
		tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		})),
		bylines: post.data.bylines ?? [],
	}));
---

<Base title={siteTitle} description={siteTagline}>
	<div class="home">
		{/* 1. The promise */}
		<section class="hero">
			<p class="hero-eyebrow">{siteTitle}</p>
			<h1 class="hero-title">{siteTagline}</h1>
			<p class="hero-sub">
				Wearable outfit ideas, getting-ready essentials and practical home
				inspiration — researched guides with honest picks.
			</p>
		</section>

		{/* 2 + 3. Category cards with a start-here guide in each */}
		<section class="categories">
			{
				startHere.map((section) => (
					<div class="category-card">
						<div class="category-head">
							<h2 class="category-name">{section.label}</h2>
							<p class="category-blurb">{section.blurb}</p>
							<a href={`/category/${section.slug}`} class="category-link">
								Browse {section.label.toLowerCase()}
								<svg
									width="13"
									height="13"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M5 12h14" />
									<path d="m12 5 7 7-7 7" />
								</svg>
							</a>
						</div>
						{section.post && (
							<a href={`/posts/${section.post.id}`} class="category-guide">
								{section.post.data.featured_image && (
									<span class="category-guide-thumb">
										<Image image={section.post.data.featured_image} />
									</span>
								)}
								<span class="category-guide-body">
									<span class="category-guide-kicker">Start here</span>
									<span class="category-guide-title">
										{section.post.data.title}
									</span>
								</span>
							</a>
						)}
					</div>
				))
			}
		</section>

		{/* 4. Recent guides */}
		{
			recentPosts.length > 0 && (
				<section class="posts-section">
					<header class="section-header">
						<h2 class="section-title">Recent guides</h2>
						<a href="/posts" class="section-link">
							View all
						</a>
					</header>
					<div class="posts-grid">
						{recentPosts.map(({ post, tags, bylines }) => (
							<PostCard
								title={post.data.title ?? "Untitled"}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={`/posts/${post.id}`}
								date={post.data.publishedAt ?? undefined}
								readingTime={getReadingTime(post.data.content)}
								tags={tags}
								bylines={bylines}
								edit={post.edit}
							/>
						))}
					</div>
				</section>
			)
		}

		{posts.length === 0 && (
			<section class="empty-state">
				<h2>No guides yet</h2>
				<p>Publish your first guide in the admin panel.</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">
					Create a guide
				</a>
			</section>
		)}

		{/* 5. Who you are */}
		<section class="about-band">
			<h2 class="about-band-title">Who's behind Living & Glow</h2>
			<p class="about-band-text">
				Living & Glow publishes practical guides to everyday style, getting
				ready, and comfortable rooms. Every pick is chosen for a reason —
				and every guide says what that reason is, including who should skip
				it.
			</p>
			<a href="/pages/about" class="about-band-link">
				How we choose products
				<svg
					width="13"
					height="13"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14" />
					<path d="m12 5 7 7-7 7" />
				</svg>
			</a>
		</section>
	</div>
</Base>

<style>
	.home {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-20);
	}

	/* Hero */
	.hero {
		max-width: 640px;
		margin: 0 auto var(--spacing-16);
		text-align: center;
	}

	.hero-eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-brand);
		margin-bottom: var(--spacing-4);
	}

	.hero-title {
		font-size: clamp(2.4rem, 5.4vw, 3.8rem);
		font-weight: var(--font-weight-display);
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-5);
	}

	.hero-sub {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* Category cards */
	.categories {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
		margin-bottom: var(--spacing-20);
	}

	.category-card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.category-head {
		padding: var(--spacing-6) var(--spacing-6) var(--spacing-5);
	}

	.category-name {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-3);
	}

	.category-blurb {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-4);
	}

	.category-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
	}

	.category-link:hover {
		color: var(--color-brand-hover);
	}

	.category-guide {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		margin-top: auto;
		padding: var(--spacing-4) var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
		background: var(--color-surface);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.category-guide:hover {
		background: var(--color-border-subtle);
	}

	.category-guide-thumb {
		flex-shrink: 0;
		width: 56px;
		height: 56px;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-border-subtle);
	}

	.category-guide-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.category-guide-body {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.category-guide-kicker {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-brand);
	}

	.category-guide-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		color: var(--color-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Section header */
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-title {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.section-link {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
	}

	.section-link:hover {
		color: var(--color-brand-hover);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.posts-section {
		margin-bottom: var(--spacing-20);
	}

	/* Who-you-are band */
	.about-band {
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
		padding-top: var(--spacing-8);
		border-top: 1px solid var(--color-border-subtle);
	}

	.about-band-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-4);
	}

	.about-band-text {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-5);
	}

	.about-band-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
	}

	.about-band-link:hover {
		color: var(--color-brand-hover);
	}

	/* Empty state */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-16) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 600;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.home {
			padding: var(--spacing-8) var(--spacing-4) var(--spacing-16);
		}

		.hero {
			margin-bottom: var(--spacing-10);
		}

		.categories {
			grid-template-columns: 1fr;
			gap: var(--spacing-4);
			margin-bottom: var(--spacing-16);
		}

		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	@media (max-width: 600px) {
		.hero-title {
			font-size: 2.1rem;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
