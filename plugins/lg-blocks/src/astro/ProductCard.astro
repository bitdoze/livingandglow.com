---
import { Image } from "emdash/ui";

const { title, image, note, caveat, url, buttonLabel } = Astro.props.node;
const hasImage =
	typeof image === "string" ? image.length > 0 : !!image;
---

<figure class:list={["lg-product", { "lg-product--media": hasImage }]}>
	{
		hasImage && (
			<span class="lg-product-image">
				{typeof image === "string" ? (
					<img src={image} alt={title || ""} loading="lazy" />
				) : (
					<Image image={image} widths={[240, 480]} sizes="132px" />
				)}
			</span>
		)
	}
	<figcaption class="lg-product-body">
		{title && <strong class="lg-product-title">{title}</strong>}
		{note && <p class="lg-product-note">{note}</p>}
		{
			caveat && (
				<p class="lg-product-caveat">
					<span class="lg-product-caveat-label">Keep in mind</span>
					{caveat}
				</p>
			)
		}
		{
			url && (
				<span class="lg-product-actions">
					<a
						class="lg-product-button"
						href={url}
						target="_blank"
						rel="sponsored nofollow noopener"
					>
						{buttonLabel || "View on Amazon"}
						<svg
							width="12"
							height="12"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 17L17 7" />
							<path d="M8 7h9v9" />
						</svg>
					</a>
					<span class="lg-product-paid">paid link</span>
				</span>
			)
		}
	</figcaption>
</figure>

<style>
	.lg-product {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-5);
		align-items: start;
		margin: 2em 0;
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}

	.lg-product--media {
		grid-template-columns: 132px minmax(0, 1fr);
	}

	.lg-product-image {
		display: block;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
		aspect-ratio: 1;
	}

	.lg-product-image img,
	.lg-product-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		border-radius: 0;
	}

	.lg-product-body {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		min-width: 0;
	}

	.lg-product-title {
		font-family: var(--font-heading);
		font-size: 1.12em;
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		line-height: 1.3;
		color: var(--color-text);
	}

	.lg-product-note {
		margin: 0;
		font-size: 0.94em;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.lg-product-caveat {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		margin: 0.2em 0 0;
		padding-top: 0.65em;
		font-size: 0.82em;
		line-height: 1.55;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border-subtle);
	}

	.lg-product-caveat-label {
		font-size: 0.78em;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.lg-product-actions {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin-top: 0.5em;
	}

	.lg-product-button {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.6em 1.15em;
		font-family: var(--font-body);
		font-size: 0.82em;
		font-weight: 600;
		line-height: 1;
		color: var(--color-on-brand);
		background: var(--color-brand);
		border-radius: var(--radius);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.lg-product-button:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
		text-decoration: none;
	}

	.lg-product-paid {
		font-size: 0.72em;
		font-weight: 500;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	@media (max-width: 560px) {
		.lg-product--media {
			grid-template-columns: 84px minmax(0, 1fr);
			gap: var(--spacing-4);
			padding: var(--spacing-4);
		}
	}
</style>
