---
const { title, image, note, caveat, url, buttonLabel } = Astro.props.node;
---

<figure class="lg-product">
	{
		image && (
			<span class="lg-product-image">
				<img src={image} alt={title || ""} loading="lazy" />
			</span>
		)
	}
	<figcaption class="lg-product-body">
		{title && <strong class="lg-product-title">{title}</strong>}
		{note && <p class="lg-product-note">{note}</p>}
		{
			caveat && (
				<p class="lg-product-caveat">
					<span class="lg-product-caveat-label">Keep in mind:</span> {caveat}
				</p>
			)
		}
		{
			url && (
				<a
					class="lg-product-button"
					href={url}
					target="_blank"
					rel="sponsored nofollow noopener"
				>
					{buttonLabel || "View on Amazon"}
					<svg
						width="12"
						height="12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M7 17L17 7" />
						<path d="M8 7h9v9" />
					</svg>
				</a>
			)
		}
	</figcaption>
</figure>

<style>
	.lg-product {
		display: grid;
		grid-template-columns: 132px minmax(0, 1fr);
		gap: var(--spacing-5);
		align-items: start;
		margin: 2em 0;
		padding: var(--spacing-5);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.lg-product-image {
		display: block;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
		aspect-ratio: 1;
	}

	.lg-product-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		border-radius: 0;
	}

	.lg-product-body {
		display: flex;
		flex-direction: column;
		gap: 0.45em;
		min-width: 0;
	}

	.lg-product-title {
		font-family: var(--font-heading);
		font-size: 1.05em;
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text);
	}

	.lg-product-note {
		margin: 0;
		font-size: 0.92em;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.lg-product-caveat {
		margin: 0;
		font-size: 0.82em;
		line-height: 1.55;
		color: var(--color-muted);
	}

	.lg-product-caveat-label {
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.lg-product-button {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		align-self: flex-start;
		margin-top: 0.35em;
		padding: 0.55em 1.1em;
		font-family: var(--font-body);
		font-size: 0.82em;
		font-weight: 600;
		line-height: 1;
		color: var(--color-on-brand);
		background: var(--color-brand);
		border-radius: var(--radius);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.lg-product-button:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
		text-decoration: none;
	}

	@media (max-width: 560px) {
		.lg-product {
			grid-template-columns: 96px minmax(0, 1fr);
			padding: var(--spacing-4);
		}
	}
</style>
