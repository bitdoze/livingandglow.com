---
const { text } = Astro.props.node;
---

<aside class="lg-disclosure">
	<p>
		{
			text ??
				"This guide contains affiliate links. I may earn a commission if you buy through them. As an Amazon Associate I earn from qualifying purchases."
		}
	</p>
</aside>

<style>
	.lg-disclosure {
		margin: 0 0 2em;
		padding: 0.85em 1.15em;
		font-size: 0.82em;
		line-height: 1.55;
		color: var(--color-text-secondary);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius);
	}

	.lg-disclosure p {
		margin: 0;
	}
</style>
